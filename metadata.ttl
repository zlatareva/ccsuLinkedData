@prefix : <https://zlatareva.github.io/ccsuLinkedData/metadata.ttl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

:CCSUCatalog a dcat:Dataset ;
    dcterms:title "CCSU Catalog - Selected Computer Science Data"@en ;
    dcterms:description
        "An illustrative RDF dataset describing selected CCSU courses and degree-program requirements from the 2025-2026 university catalog."@en ;
    dcat:landingPage
        <https://github.com/zlatareva/ccsuLinkedData> ;
    dcat:distribution :CatalogTurtle .

:CatalogTurtle a dcat:Distribution ;
    dcterms:title "CCSU Catalog in Turtle Format"@en ;
    dcat:mediaType
        <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcat:downloadURL
        <https://zlatareva.github.io/ccsuLinkedData/catalog.ttl> .
